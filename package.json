{
  "name": "@jasonews/agent-squad",
  "version": "1.0.3",
  "description": "Local external-subagent runtime for coding CLIs.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JASONews/agent-squad.git"
  },
  "homepage": "https://github.com/JASONews/agent-squad#readme",
  "bugs": {
    "url": "https://github.com/JASONews/agent-squad/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/bin/agent-squad.js",
  "bin": {
    "agent-squad": "dist/bin/agent-squad.js",
    "agent-squadd": "dist/bin/agent-squadd.js",
    "agent-squad-mcp": "dist/bin/agent-squad-mcp.js"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build-package.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@modelcontextprotocol/server": "^2.0.0-beta.0",
    "better-sqlite3": "^12.11.1",
    "commander": "^12.1.0",
    "fastify": "^5.2.0",
    "ink": "^5.0.1",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "zod": "^3.25.0"
  }
}
